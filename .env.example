# Application dates and admin display timezone
APP_TIMEZONE=America/Los_Angeles

# RingCentral Personal JWT integration
RINGCENTRAL_BASE_URL=https://platform.ringcentral.com
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=
RINGCENTRAL_ACCOUNT_ID=~
# How soon after the click a call must start to be credited to it.
RINGCENTRAL_MATCH_WINDOW_SECONDS=60
# How long we keep polling the call log — a call lands there only after it ends.
RINGCENTRAL_LOOKUP_WINDOW_MINUTES=10
RINGCENTRAL_CLOCK_TOLERANCE_SECONDS=30
RINGCENTRAL_RETRY_DELAY_SECONDS=120

# OpenAI call transcription + summary (linked RC calls only)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_SUMMARY_MODEL=gpt-5.4-nano
OPENAI_TRANSCRIPT_MIN_DURATION_SECONDS=20
OPENAI_TRANSCRIPT_STUCK_MINUTES=15

# Google Ads offline conversions — uploaded when a phone click is confirmed by a RingCentral call.
# Developer token: https://developers.google.com/google-ads/api/docs/api-policy/developer-token
# Conversion action must be an "Import"/offline action; copy its full resource name.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_PHONE_CONVERSION_ACTION=
# Exact name of the offline conversion action in the Google Ads UI (sheet import column).
GOOGLE_ADS_PHONE_CONVERSION_NAME="Phone Call Confirmed"
# Must also be listed as an authorized redirect URI on the OAuth client.
GOOGLE_ADS_OAUTH_REDIRECT_URI=http://localhost

# Daily Google Drive sheet export of RingCentral-confirmed phone clicks with a GCLID.
# Share the Drive folder with the service account email (Editor). Path or raw JSON.
GOOGLE_DRIVE_AUTH=service_account
GOOGLE_DRIVE_FOLDER_ID=1rCfaF8tk29fPPdO0zljjRXyMIp4PLALv
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# Optional: force one workbook (otherwise find/create "Google Ads Offline Conversions" in the folder).
# GOOGLE_DRIVE_SPREADSHEET_ID=
# Alternative to service account: OAuth refresh token with drive + spreadsheets scopes.
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_EXPORT_TIMEZONE=America/Los_Angeles

# Microsoft Ads (Bing) offline conversions — same trigger, matched by MSCLKID.
# Developer token: https://developers.ads.microsoft.com/Account
# The goal name must match the Offline conversion goal in the Microsoft Ads UI exactly.
MICROSOFT_ADS_DEVELOPER_TOKEN=
# "microsoft" for Entra ID / MSA sign-in, "google" when the Microsoft Advertising
# account is opened with "Sign in with Google". Using the wrong one fails with
# IdentityTypeMismatch. With google, CLIENT_ID/SECRET come from Google Cloud.
MICROSOFT_ADS_IDENTITY_PROVIDER=microsoft
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_REFRESH_TOKEN=
MICROSOFT_ADS_CUSTOMER_ID=
MICROSOFT_ADS_ACCOUNT_ID=
MICROSOFT_ADS_PHONE_CONVERSION_NAME="Phone Call Confirmed"
# Defaults per provider: the Microsoft nativeclient URI, or http://localhost for google.
MICROSOFT_ADS_OAUTH_REDIRECT_URI=

# A continuously running worker is required for delayed call matching.
QUEUE_CONNECTION=database
