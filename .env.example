# Application dates and admin display timezone
APP_TIMEZONE=America/Los_Angeles

# RingCentral Personal JWT integration
RINGCENTRAL_BASE_URL=https://platform.ringcentral.com
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=
RINGCENTRAL_ACCOUNT_ID=~
RINGCENTRAL_MATCH_WINDOW_MINUTES=10
RINGCENTRAL_CLOCK_TOLERANCE_SECONDS=30
RINGCENTRAL_RETRY_DELAY_SECONDS=120

# A continuously running worker is required for delayed call matching.
QUEUE_CONNECTION=database
